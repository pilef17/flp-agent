# Supabase (Projekt-Einstellungen → API). Keine echten Werte einchecken!
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Nur serverseitig! Wird für Einladungen und (später) Stripe-Webhooks benötigt.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Öffentliche Basis-URL (für E-Mail-Links und Stripe-Redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: eigene Domain für die Wochenfrage (ohne https://). Auf dieser Domain öffnet «/»
# direkt die Frage, z. B. frage.flp-performance.ch. Leer lassen = Link …/wochenfrage
# WOCHENFRAGE_HOST=frage.flp-performance.ch
# Optional: WhatsApp-Nummer des Trainers. Nach dem Senden erscheint der Knopf
# «Antwort an Trainer senden», der WhatsApp mit der fertigen Nachricht öffnet.
# WOCHENFRAGE_WHATSAPP=+41 79 123 45 67

# Stripe (Dashboard → Entwickler → API-Schlüssel). Für Tests sk_test_… verwenden.
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook-Signatur: Dashboard → Webhooks bzw. `stripe listen` (lokal)
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Nur für lokale Tests mit stripe-mock – in Produktion NICHT setzen
# STRIPE_API_BASE=http://localhost:12111

# E-Mail an den Trainer bei neuen Anfragen aus dem Spieler-Check (optional).
# Beispiel Infomaniak: SMTP_HOST=mail.infomaniak.com, SMTP_PORT=465, SMTP_USER=Ihre Adresse, SMTP_PASS=Passwort des Postfachs
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# LEAD_NOTIFY_TO=
