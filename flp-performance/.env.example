# Supabase (Projekt-Einstellungen → API). Keine echten Werte einchecken!
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Nur serverseitig! Wird für Einladungen und (später) Stripe-Webhooks benötigt.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Öffentliche Basis-URL (für E-Mail-Links und Stripe-Redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (Dashboard → Entwickler → API-Schlüssel). Für Tests sk_test_… verwenden.
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook-Signatur: Dashboard → Webhooks bzw. `stripe listen` (lokal)
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Nur für lokale Tests mit stripe-mock – in Produktion NICHT setzen
# STRIPE_API_BASE=http://localhost:12111
